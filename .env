# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

WAIT_FOR_TX_CONFIRMATIONS=FALSE
WAIT_FOR_VERIFICATION_RESULT=TRUE

# Sleep between consecutive measurements in milliseconds.
# 0 = run measurements back-to-back, bounded only by CPU_LIMIT (cgroup).
# Increase if you need a wider local vulnerability window for security/perf tuning.
ATTESTATION_INTERVAL_MS=10000
# fixed = the delay before each measurement is ATTESTATION_INTERVAL_MS;
# exp = it is drawn from an exponential law of that mean. Required.
ATTESTATION_INTERVAL_MODE=fixed
CPU_LIMIT=0.4
# IterQ (rolling hash) threshold K: number of fresh measurements folded into
# one on-chain attestation. K=1 = single-shot, K>1 = rolling-hash chain.
ITERQ_THRESHOLD=1

ENABLE_LIBS_HASH=FALSE
SELF_INTEGRITY_ENABLED=TRUE

# Auto-start background workers/watchers on app boot (TRUE/FALSE)
AUTO_START=FALSE

ROUNDS=0

# EventWatcher: how many blocks behind head to process logs
EVENT_CONFIRMATIONS=0

# EventWatcher: seconds between polling eth_getLogs when caught up
EVENT_POLL_INTERVAL=0.2

# EventWatcher: max block range per eth_getLogs request
EVENT_BATCH_SIZE=500

ROS_DOMAIN_ID=42

# Database (PostgreSQL)
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=attestation

COMPOSE_PROJECT_NAME=ros2-b-mutra
N_ROBOTS=4
DEPLOY_MODE=local
GAZEBO_WORLD=empty
ENABLE_NAV2=FALSE
MITIGATION=true
RUN_TAG=run
MISSION_FILE=/app/missions/turtlebot3_world.json
ENABLE_FORMATION=FALSE
FORMATION_SCALE=2.0
RUN_DURATION_S=400
GOAL_X=60.0
GOAL_Y=0.0
K_ATT=0.8
K_FORM=1.5
FORMATION_DATA_SUBDIR=tamper-impact/.staging
CONTRACT=AttestationManagerV3
SALT_MEASUREMENT=TRUE
DUMMY=TRUE
JURY_SIZE=2
JURY_THRESHOLD=2
JURY_TIMEOUT_BLOCKS=5
FRESHNESS_BLOCKS=15
REMOTE1_HOST=10.5.1.20
REMOTE2_HOST=
POLL_INTERVAL_S=0.2
